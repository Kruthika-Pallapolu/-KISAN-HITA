# ==============================================================================
# Kisan Hita (కిసాన్ హిత) — Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# Never commit the .env file containing real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking Settings
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
# SQLite database file path. For Docker/Cloud persistence, mount a volume (e.g. /data/kisan_hita.db)
DATABASE_PATH=kisan_hita.db

# CORS Allowed Origins: explicit comma-separated web origins; do not use wildcard with cookies
# In production, set to your frontend domain: e.g. "https://kisan-hita.vercel.app,http://localhost:5173"
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. Google AI / Gemini Configuration (Active Generative Reasoning Provider)
# ------------------------------------------------------------------------------
# Provide your Google AI Studio API key to enable live agricultural reasoning and vision inspection.
# If unset or invalid, the backend gracefully falls back to deterministic rule-based responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Voice Provider Selection
# ------------------------------------------------------------------------------
# Active provider: "temporary" (browser-native Web Speech API + typed fallback)
# "gnani" is reserved for the final competition deployment stage.
VOICE_PROVIDER=temporary

# ------------------------------------------------------------------------------
# 4. Gnani AI Configuration (⚠️ DORMANT TO PROTECT API CREDITS)
# ------------------------------------------------------------------------------
# Keep disabled until the live provider is genuinely integrated and tested.
GNANI_LIVE_ENABLED=false
GNANI_PRISMA_ENABLED=false
GNANI_TIMBRE_ENABLED=false
GNANI_API_KEY=
GNANI_TOKEN=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_WS_STT_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_PRISMA_MODEL=prisma-v3.0
GNANI_TIMBRE_MODEL=timbre-v3.0
# Timbre v3.0 voices support all ten documented languages.
GNANI_TIMBRE_VOICE_EN=Vasudha
GNANI_TIMBRE_VOICE_TE=Vasudha
GNANI_TIMBRE_VOICE_HI=Vasudha
GNANI_TIMBRE_VOICE_TA=Vasudha
GNANI_TIMBRE_VOICE_KN=Vasudha
GNANI_TIMBRE_VOICE_ML=Vasudha
GNANI_TIMBRE_VOICE_MR=Vasudha

# ------------------------------------------------------------------------------
# 5. External Agricultural Data Providers
# ------------------------------------------------------------------------------
# WeatherAPI.com key (backend only; required for every weather request)
WEATHERAPI_KEY=
# Outbound HTTP timeout in seconds; incomplete live data is reported unavailable
WEATHER_TIMEOUT_SECONDS=6.0

# Set true behind HTTPS in production; false only for local HTTP development.
COOKIE_SECURE=false
